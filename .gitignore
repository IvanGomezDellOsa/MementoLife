extension/dist/
extension/build/
extension/*.zip

# Módulos TS generados desde content/ y render-core/ por scripts/gen-data.ts.
# Fuente de verdad: los JSON. No se duplican a mano ni se commitean.
extension/src/data/

# Salidas de Playwright (los goldens PNG de e2e/golden/ SÍ se commitean; esto es el ruido)
extension/test-results/
extension/playwright-report/
extension/blob-report/

